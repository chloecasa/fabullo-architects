{"id":1,"featuredProjects":[{"id":1,"title":"Sun Garden House","slug":"sun-garden-house","category":"RESIDENTIAL","year":"2025","heroImg":{"id":1,"alt":"Sun Garden House - Entrance Hero","updatedAt":"2026-06-01T10:52:15.441Z","createdAt":"2026-05-31T04:55:45.446Z","url":"/api/media/file/Sun%20Garden%20Hero-1.jpeg","thumbnailURL":null,"filename":"Sun Garden Hero-1.jpeg","mimeType":"image/jpeg","filesize":1780127,"width":2500,"height":3726,"focalX":50,"focalY":50},"credits":"PHOTOGRAPHY BY PRUE RUSCOE AND STYLED BY OLGA LEWIS","team":[{"id":"6a1bbfc23de078608900cc1c","label":"MCK TEAM","val":"MAKI YAMAJI, SU LIEW, STEVE KOOLLOOS"},{"id":"6a355bdc0d1c54574baa3b7b","label":"BUILDER","val":"RICHARDS BUILDING"},{"id":"6a355bfc0d1c54574baa3b7c","label":"STRUCTURAL ENGINEER","val":"SDA STRUCTURES"},{"id":"6a355c0b0d1c54574baa3b7d","label":"LANDSCAPE ARCHITECTS","val":"MARIKO FRASER"},{"id":"6a355c180d1c54574baa3b7e","label":"INTERIOR DESIGN ","val":"MCK ARCHITECTS"}],"consultants":[{"id":"6a1bbfdf3de078608900cc1e","label":"PLANNING","val":"GSA PLANNING"},{"id":"6a355c2f0d1c54574baa3b7f","label":"HERITAGE ADVICE","val":"ZOLTAN KOVACS"},{"id":"6a355c3b0d1c54574baa3b80","label":"JOINERY","val":"ELAN"},{"id":"6a355c470d1c54574baa3b81","label":"SOLAR BLINDS","val":"SHADE FACTOR"},{"id":"6a355c570d1c54574baa3b82","label":"GLASS BRICKS","val":"AUSTRAL"}],"slides":[{"id":"6a1bc0013de078608900cc20","text":"PRESENTED TO THE STREET AS A REINVIGORATED VICTORIAN TERRACE, THE GHRIAN-GLYPH HOUSE APPEARS UNDERSTATED AND AS TRADITIONAL AS THE DAY IT WAS BUILT."},{"id":"6a1bc3843de078608900cc32","text":"THE ENTRY POINT IS DEFINED BY THE FILIGREE ONE MIGHT EXPECT OF IT’S ILK, YET THE JOURNEY IN TAKES NO TIME TO ALERT THE INHABITANT TO IT’S CONTEMPORARY TWIST, PRESENTING A GENEROUS SOURCE OF LIGHT AT THE END OF THE TUNNEL, SOMEWHERE BEYOND THE SEAMLESS BLACK BALUSTRADE THAT FLANKS THE STAIR LEADING DOWN TO THE NEW LIVING ZONE."},{"id":"6a1bc3893de078608900cc34","text":"COMPACT IN PLAN YET GENEROUS IN AMENITY, A DOUBLE HEIGHT VOID INVITES THE NORTHERN LIGHT DEEP INTO THE LONG PLAN. "},{"id":"6a1bc38d3de078608900cc36","text":"THE SAME LIGHT IS BORROWED TO ILLUMINATE A FIRST FLOOR BATHROOM SITTING TRANSLUCENT ABOVE AND THE PRIMARY CIRCULATION SPINE RUNNING PARALLEL TO ONE PARTY WALL. THE BLACK PLATE STEEL BALUSTRADE REMAINS COHESIVE TO ALL OF THE HO,MES FUNCTIONS AND IS EVER PRESENT AT EACH LEVEL."}],"verticalImages":[{"id":"6a1bc00e3de078608900cc22","image":{"id":9,"alt":"SUN1","updatedAt":"2026-06-19T15:17:12.038Z","createdAt":"2026-06-19T15:16:21.875Z","url":"/api/media/file/88%2Bpaddington%2Bst%2B507%2B1.jpeg","thumbnailURL":null,"filename":"88+paddington+st+507+1.jpeg","mimeType":"image/jpeg","filesize":2252131,"width":2500,"height":3732,"focalX":50,"focalY":50}},{"id":"6a1bc39c3de078608900cc38","image":{"id":10,"alt":"SUN2","updatedAt":"2026-06-19T15:16:54.085Z","createdAt":"2026-06-19T15:16:52.315Z","url":"/api/media/file/88%2Bpaddington%2Bst%2B91%2B1.jpeg","thumbnailURL":null,"filename":"88+paddington+st+91+1.jpeg","mimeType":"image/jpeg","filesize":1780127,"width":2500,"height":3726,"focalX":50,"focalY":50}},{"id":"6a1bc3c93de078608900cc3c","image":{"id":11,"alt":"SUN3","updatedAt":"2026-06-19T15:17:37.742Z","createdAt":"2026-06-19T15:17:35.752Z","url":"/api/media/file/88%2Bpaddington%2Bst%2B103.jpeg","thumbnailURL":null,"filename":"88+paddington+st+103.jpeg","mimeType":"image/jpeg","filesize":2047462,"width":2500,"height":3748,"focalX":50,"focalY":50}},{"id":"6a1bc3e13de078608900cc40","image":{"id":12,"alt":"SUN4","updatedAt":"2026-06-19T15:17:59.194Z","createdAt":"2026-06-19T15:17:57.309Z","url":"/api/media/file/88%2Bpaddington%2Bst%2B18%2B1%2B1.jpeg","thumbnailURL":null,"filename":"88+paddington+st+18+1+1.jpeg","mimeType":"image/jpeg","filesize":1065767,"width":2500,"height":3748,"focalX":50,"focalY":50}}],"horizontalGallery":[{"id":"6a1bc01b3de078608900cc24","image":{"id":13,"alt":"SUN5","updatedAt":"2026-06-19T15:19:42.102Z","createdAt":"2026-
datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Table: allowed_admins (Secure DB Allowlist)
model AllowedAdmin {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  userId String? @map("user_id")

  @@map("allowed_admins")
}

// 2. Table: subscribers (Newsletter Audience Logs)
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

// 3. Table: projects (CMS Portfolios & Local SEO)
model Project {
  id                Int      @id @default(autoincrement())
  title             String
  credits           String?
  category          String   // RESIDENTIAL, COMMERCIAL, UNBUILT
  slug              String   @unique
  heroImg           String   @map("hero_img") // Cloudinary URL
  team              Json?    // PostgreSQL JSONB: Array of { label: string, val: string }
  consultants       Json?    // PostgreSQL JSONB: Array of { label: string, val: string }
  slides            Json?    // PostgreSQL JSONB: Array of strings
  verticalImages    Json?    @map("vertical_images") // PostgreSQL JSONB: Array of URLs
  horizontalGallery Json?    @map("horizontal_gallery") // PostgreSQL JSONB: Array of URLs
  viewsCount        Int      @default(0) @map("views_count")

  @@map("projects")
}

// 4. Table: leads (CRM Sales Funnel & Scoring)
model Lead {
  id                Int       @id @default(autoincrement())
  name              String
  email             String
  phone             String?
  message           String?
  masterpieceChoice String    @map("masterpiece_choice")
  ethosChoice       String    @map("ethos_choice")
  acquisitionChoice String    @map("acquisition_choice")
  councilChoice     String    @map("council_choice")
  budgetChoice      String    @map("budget_choice")
  leadScore         Int       @map("lead_score")
  pdfUrl            String?   @map("pdf_url")
  pipelineStage     String    @default("new") @map("pipeline_stage")
  status            String    @default("active")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("leads")
}

// 5. Table: journal_entries (Dynamic Editorial Journal CMS)
model JournalEntry {
  id              Int      @id @default(autoincrement())
  title           String
  subtitle        String
  desc            String
  img             String
  previewTemplate String   @map("preview_template")
  previewSlides   Json?    @map("preview_slides") // PostgreSQL JSONB Column
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("journal_entries")
}
